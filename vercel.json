{
	"git": {
		"deploymentEnabled": {
			"**": false,
			"main": true
		}
	},
	"headers": [
		{
			"source": "/service-worker.js",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "no-cache"
				}
			]
		}
	],
	"crons": [
		{
			"path": "/api/cron/due",
			"schedule": "0 3 * * *"
		},
		{
			"path": "/api/cron/bot-ranges-refresh",
			"schedule": "45 4 * * *"
		}
	]
}
