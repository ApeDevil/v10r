# .env.example — every variable the app reads, declared in src/env.ts.
#
# Copy to .env for local development (compose.yaml loads it into the container). Three tiers:
#   1. REQUIRED     — the app does not boot, or a core path fails, without these.
#   2. FEATURES     — each block switches one integration on; unset, that feature is off or
#                     degrades (a showcase says "not configured", an endpoint answers 503).
#   3. OVERRIDES    — commented out on purpose. The code default (shown) is right unless you
#                     have a reason; uncomment only to change it.
# Never set what a platform supplies itself: NODE_ENV, VERCEL, VERCEL_ENV,
# VERCEL_GIT_COMMIT_SHA (Vercel), PORT (Render, runtime-lab). The full model:
# docs/blueprint/deployment.md#environment-variables.

# ══ 1. REQUIRED ══════════════════════════════════════════════════════════════

# Database - Neon PostgreSQL
# Get connection string from: https://console.neon.tech
# MUST use the DIRECT (non-pooled) URL — no "-pooler" in hostname
# Pooled endpoint breaks drizzle-kit (PgBouncer disables SET/PREPARE)
# HTTP driver (@neondatabase/serverless) is stateless — pooling is irrelevant for app runtime
# THE active connection — app, drizzle-kit and scripts all read this. Point it at
# whichever branch you're working against (in production, the prod branch).
NEON_DATABASE_URL_PROD="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# Better Auth — the root secret. Also the root of every derived key (security/subkey.ts).
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"

# OAuth — GitHub
# Create at: https://github.com/settings/developers > OAuth Apps > New
# Callback URL: {site URL}/api/auth/callback/github  (locally http://localhost:5173/…)
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# OAuth — Google
# Create at: https://console.cloud.google.com > APIs & Services > Credentials > OAuth 2.0
# Callback URL: {site URL}/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Encryption at rest. AES-256-GCM key for every stored credential: the AI provider API keys
# entered under Admin → AI → Models and the name-check vendor secrets entered under
# Admin → Name check. It lives only here, never in the database; losing it invalidates all of
# them, and placeholder values are rejected outside dev.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="64-char-hex-string"

# Admin gate — who has admin access. ADMIN_USER_ID is a comma-separated list of
# admin user ids (one per admin), immutable so admin can't be transferred by
# re-claiming an email. Bootstrap a fresh install by signing in once (any OAuth
# method creates the user row), then copy that row's id (auth."user".id) here.
# The first id is also the "system author" for file-pushed content.
ADMIN_USER_ID="usr_xxxxxxxx,usr_yyyyyyyy"

# Cache - Upstash Redis — rate limiting and the captcha replay store. Without it the limiter
# passes through in dev and fails closed in production.
# Get credentials from: https://console.upstash.com (REST URL and REST Token)
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="AXxx..."

# Anti-abuse — ALTCHA HMAC key (signs/verifies captcha challenges). Outside dev it must be 32+
# chars and not look like a placeholder, or the build fails.
# Generate with: openssl rand -hex 32
ALTCHA_HMAC_KEY=""

# Vercel cron — the bearer token Vercel sends to /api/cron/* (it reads this same variable).
# Generate with: openssl rand -base64 32
CRON_SECRET="generate-with-openssl-rand-base64-32"

# AI providers are NOT configured here. Sign in as an admin and open Admin → AI → Models
# to connect Groq / OpenAI / Google Gemini: keys are stored in the database encrypted
# under ENCRYPTION_KEY (above), and a saved change reaches the next request without a
# restart or redeploy. Embeddings (search, retrieval) use the Google Gemini connection.

# ══ 2. FEATURES — unset switches the feature off ═════════════════════════════

# Graph Database - Neo4j Aura (graph showcase, catalog sync)
# Get credentials from: https://console.neo4j.io
NEO4J_URI="neo4j+s://xxx.databases.neo4j.io"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="your-password"
# Newer Aura instances name the database (and often the user) after the 8-hex-char instance
# id; the code default `neo4j` fits only older instances and local Neo4j.
NEO4J_DATABASE="neo4j"

# Object Storage - Cloudflare R2
# Get credentials from: https://dash.cloudflare.com > Storage & Databases > R2
# Account ID: Workers & Pages > Account details (32-char hex)
# API token: R2 > Manage R2 API tokens > Create API token (Object Read & Write)
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key-id"
R2_SECRET_ACCESS_KEY="your-secret-access-key"
R2_BUCKET_NAME="your-bucket-name"

# Privacy / GDPR data-controller contact shown on the public privacy pages.
# Use a role address, never a personal one — this is published publicly.
# Unset ⇒ the pages show privacy@example.com.
PRIVACY_CONTACT_EMAIL="privacy@yourdomain.com"

# Notifications — Email (Resend). Also sends the magic-link / OTP sign-in emails.
# Create at: https://resend.com/api-keys
# Requires a verified domain for production, or use onboarding@resend.dev for testing
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="notifications@yourdomain.com"

# Notifications — Telegram
# Create a bot via @BotFather in Telegram. The webhook answers 503 until
# TELEGRAM_WEBHOOK_SECRET is set; register it as the secret_token (Telegram allows only
# letters, digits, _ and -, so generate with openssl rand -hex 32, not base64):
# curl -X POST "https://api.telegram.org/bot<TOKEN>/setWebhook" -H "Content-Type: application/json" \
#   -d '{"url": "https://yourdomain.com/api/webhooks/telegram", "secret_token": "<SECRET>"}'
# Local dev requires a tunnel (ngrok/cloudflared) for the webhook
TELEGRAM_BOT_TOKEN="123456:ABC-DEF..."
TELEGRAM_BOT_USERNAME="YourBotName"
TELEGRAM_WEBHOOK_SECRET=""

# Notifications — Discord
# Create at: https://discord.com/developers/applications
# Bot tab: create bot, copy token. OAuth2 tab: copy client ID/secret, add the redirect URI
# {site URL}/account/notifications/settings/discord/callback — derived from the site URL,
# never configured here (locally http://localhost:5173/account/notifications/settings/discord/callback).
# Bot needs "Send Messages" permission and must share a server with the user to DM them.
DISCORD_CLIENT_ID="your-discord-client-id"
DISCORD_CLIENT_SECRET="your-discord-client-secret"
DISCORD_BOT_TOKEN="your-discord-bot-token"

# Notifications — Web Push (VAPID)
# Generate the keypair: bunx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="BExample-base64url-public-key"
# Server secret — never expose to the client (unlike the public key above)
VAPID_PRIVATE_KEY="Example-base64url-private-key"

# ── MCP server ───────────────────────────────────────────────────────────────
# Bearer credential for the private admin MCP endpoint (/api/mcp/admin).
# Machine secret — never commit. Unset ⇒ the endpoint returns 503, never public.
# Generate with: openssl rand -base64 32
MCP_ADMIN_TOKEN=""
# Bearer credential for the private PATTERN endpoint (/api/mcp/private) — a
# separate realm from MCP_ADMIN_TOKEN; neither token opens the other surface.
# Held only by the operator's own projects: it is the switch that turns full
# self-telemetry (query + answer capture) on. Unset ⇒ the endpoint returns 503.
# Generate with: openssl rand -hex 32
MCP_PRIVATE_TOKEN=""
# HMAC key for MCP usage-telemetry caller keys: client_key = HMAC-SHA256(salt,
# ip:ua:UTC-date). Unset ⇒ client_key is NULL (fails open on the column, never
# the row) — the admin Capability Gaps panel needs >=3 distinct callers before
# it shows a query, so with no salt it stays permanently empty, and the private
# lane's repeat-ask probe has nothing to join on. Must rotate (monthly), so it is
# deliberately NOT derived from BETTER_AUTH_SECRET (mcp/telemetry/client-key.ts).
# Generate with: openssl rand -base64 32
MCP_TELEMETRY_SALT=""
# Shared secret the operator's own tooling sends as the X-V10r-Self header so
# its MCP calls are classified traffic='self' instead of 'external'. Unset ⇒
# your own curl counts as external adoption in the usage dashboard.
MCP_SELF_TRAFFIC_TOKEN=""

# ── Neon Management API (Admin → Database → Mirror) ──────────────────────────
# Enables dev-branch refresh ("reset dev from prod"). Without these the
# Mirror/Runs tabs degrade to observe-only. Server-only.
# API key:    Neon Console → Account settings → API keys
# Project id: GET https://console.neon.tech/api/v2/projects  (or the console URL)
# Branch id:  Neon Console → Branches (the br-… of your dev branch)
NEON_API_KEY=""
NEON_PROJECT_ID=""
NEON_DEV_BRANCH_ID=""

# ── DB Monitoring (Admin) ────────────────────────────────────────────────────
UPSTASH_MGMT_API_KEY=""
UPSTASH_EMAIL=""
UPSTASH_DB_ID=""
# Account id comes from R2_ACCOUNT_ID above — same Cloudflare account.
CLOUDFLARE_ANALYTICS_TOKEN=""

# ── External Service Lab (services/runtime-lab) ──────────────────────────────
# Local target: `podman compose --profile external-service up -d runtime-lab`, then the app
# reaches it as http://runtime-lab:8080. The token is also handed to the service by compose.
# Remote target (Render): the service's https URL and the SERVICE_TOKEN set on Render.
EXTERNAL_SERVICE_LOCAL_URL=""
EXTERNAL_SERVICE_LOCAL_TOKEN=""
EXTERNAL_SERVICE_REMOTE_URL=""
EXTERNAL_SERVICE_REMOTE_TOKEN=""

# ══ 3. OVERRIDES — code defaults; uncomment only to change one ═══════════════

# The canonical site URL (auth/site-url.ts). Default in dev: http://localhost:5173.
# REQUIRED outside dev (production: https://www.your-domain). Auth's baseURL and trusted
# origin, the passkey rpID, the Discord redirect URI and the Web Push contact derive from it.
# BETTER_AUTH_URL="http://localhost:5173"

# Web Push contact URI. Default: the site URL when it is https; a local http site URL leaves
# push unconfigured, so set a mailto: here to test push locally.
# VAPID_SUBJECT="mailto:you@yourdomain.com"

# Only while rotating ENCRYPTION_KEY: the previous key(s), comma-separated. They open what they
# sealed; the daily `encryption-reseal` job moves those secrets onto ENCRYPTION_KEY. Remove once
# that job ran clean (docs/blueprint/security/key-ring.md).
# ENCRYPTION_KEY_PREVIOUS=""

# Per-purpose keys, derived from BETTER_AUTH_SECRET via HMAC domain separation
# (security/subkey.ts). Set one only to rotate it independently of the auth secret.
# ANALYTICS_VISITOR_SALT rotation re-buckets visitor_id: rotate at or above the 60-day
# analytics retention window. ANALYTICS_CONFIRM_SECRET rotation invalidates in-flight
# confirmation tokens (10-minute TTL). PAIRING_SECRET rotation ends every paired phone session.
# ANALYTICS_VISITOR_SALT=""
# ANALYTICS_CONFIRM_SECRET=""
# BLOG_UPLOAD_TICKET_SECRET=""
# PAIRING_SECRET=""

# Abuse kill switch: live (default) | dry_run | off. Only `live` is accepted outside dev.
# BOT_DETECTION_MODE="live"

# Extra browser origins allowed to call the MCP endpoints, comma-separated. Default: none —
# same-origin and Origin-less (non-browser) clients are always allowed. Needed only for a
# browser-based client on another origin, e.g. the MCP Inspector. Entries are compared as FULL
# origins; a bare host is normalized to https://.
# MCP_ALLOWED_ORIGINS="http://127.0.0.1:6274"

# Parent of the Neon dev branch. Default: the dev branch's own parent_id.
# NEON_PARENT_BRANCH_ID=""
# "true" enables the SCHEDULED dev-branch auto-refresh (vercel.json cron + container
# scheduler). Default off — each run overwrites the dev branch with prod's current state.
# DBOPS_AUTO_REFRESH_ENABLED="false"

# Dev-environment gates. There is ONE database for every environment
# (NEON_DATABASE_URL_PROD), so analytics collection and the job scheduler are
# muted while `dev` is true. Set "true" only when deliberately testing the
# analytics showcase or job behaviour locally — everything written goes into
# the production tables.
# ANALYTICS_DEV_TRACKING="true"
# JOBS_DEV_ENABLED="true"

# Container-mode scheduler intervals (ignored on Vercel, which runs jobs by cron).
# JOB_INTERVAL_MS="10800000"       # default 3 h
# DELIVERY_INTERVAL_MS="15000"     # default 15 s
