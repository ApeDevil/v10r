# Database - Neon PostgreSQL
# Get connection string from: https://console.neon.tech
# MUST use the DIRECT (non-pooled) URL — no "-pooler" in hostname
# Pooled endpoint breaks drizzle-kit (PgBouncer disables SET/PREPARE)
# HTTP driver (@neondatabase/serverless) is stateless — pooling is irrelevant for app runtime
# THE active connection — app, drizzle-kit and scripts all read this. Point it at
# whichever branch you're working against (in production, the prod branch).
NEON_DATABASE_URL_PROD="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"
# Optional labeled spare for the dev branch. NOT read by code — a handy record;
# the dev-branch refresh feature targets it via the Neon API, not this string.
NEON_DATABASE_URL_DEV=""

# ── Neon Management API (Admin → Database → Mirror) ───────────────────────────
# Enables dev-branch refresh ("reset dev from prod"). Without these the
# Mirror/Runs tabs degrade to observe-only. Server-only — never PUBLIC_.
# API key:    Neon Console → Account settings → API keys
# Project id: GET https://console.neon.tech/api/v2/projects  (or the console URL)
# Branch ids: Neon Console → Branches (the br-… of your dev branch; parent optional)
NEON_API_KEY=""
NEON_PROJECT_ID=""
NEON_DEV_BRANCH_ID=""
# Optional — defaults to the dev branch's own parent_id when unset:
NEON_PARENT_BRANCH_ID=""
# Set "true" to enable the SCHEDULED auto-refresh (vercel.json cron + container
# scheduler). Leave "false" while actively developing — each run overwrites the
# dev branch with prod's current state.
DBOPS_AUTO_REFRESH_ENABLED="false"

# Graph Database - Neo4j Aura
# Get credentials from: https://console.neo4j.io
NEO4J_URI="neo4j+s://xxx.databases.neo4j.io"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="your-password"

# Cache - Upstash Redis
# Get credentials from: https://console.upstash.com
# Create a database, then copy REST URL and REST Token from the dashboard
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="AXxx..."

# Object Storage - Cloudflare R2
# Get credentials from: https://dash.cloudflare.com > Storage & Databases > R2
# Account ID: Workers & Pages > Account details (32-char hex)
# API token: R2 > Manage R2 API tokens > Create API token (Object Read & Write)
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key-id"
R2_SECRET_ACCESS_KEY="your-secret-access-key"
R2_BUCKET_NAME="your-bucket-name"

# Better Auth
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:5173"

# Privacy / GDPR data-controller contact shown on public admin/privacy pages.
# Use a role address, never a personal one — this is published publicly.
PRIVACY_CONTACT_EMAIL="privacy@yourdomain.com"

# OAuth — GitHub
# Create at: https://github.com/settings/developers > OAuth Apps > New
# Callback URL: {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# OAuth — Google
# Create at: https://console.cloud.google.com > APIs & Services > Credentials > OAuth 2.0
# Callback URL: {BETTER_AUTH_URL}/api/auth/callback/google
# Enable: Google+ API (or "Google Identity" in newer console)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Admin gate — who has admin access. ADMIN_USER_ID is a comma-separated list of
# admin user ids (one per admin), immutable so admin can't be transferred by
# re-claiming an email. Bootstrap a fresh install by signing in once (any OAuth
# method creates the user row), then copy that row's id (auth."user".id) here.
# The first id is also the "system author" for file-pushed content.
ADMIN_USER_ID="usr_xxxxxxxx,usr_yyyyyyyy"

# AI — Groq
# Create at: https://console.groq.com/keys
# Free tier: 14,400 requests/day, Llama 3.3 70B
GROQ_API_KEY="gsk_..."

# AI — OpenAI (optional)
# Create at: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# AI — Google Gemini (optional)
# Create at: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY="AIza..."

# AI — Provider Selection (optional, default: first configured)
# Options: groq, sai, google
AI_PROVIDER=""

# Notifications — Email (Resend)
# Create at: https://resend.com/api-keys
# Requires a verified domain for production, or use onboarding@resend.dev for testing
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="notifications@yourdomain.com"

# Notifications — Telegram
# Create a bot via @BotFather in Telegram, then register webhook:
# curl -X POST "https://api.telegram.org/bot<TOKEN>/setWebhook" -H "Content-Type: application/json" -d '{"url": "https://yourdomain.com/api/telegram/webhook"}'
# Local dev requires a tunnel (ngrok/cloudflared) for the webhook
TELEGRAM_BOT_TOKEN="123456:ABC-DEF..."
TELEGRAM_BOT_USERNAME="YourBotName"
# Webhook secret for verifying requests from Telegram (required in production)
# Generate with: openssl rand -base64 32
# Pass as secret_token when registering the webhook:
# curl -X POST "https://api.telegram.org/bot<TOKEN>/setWebhook" -H "Content-Type: application/json" \
#   -d '{"url": "https://yourdomain.com/api/telegram/webhook", "secret_token": "<SECRET>"}'
TELEGRAM_WEBHOOK_SECRET="generate-with-openssl-rand-base64-32"

# Notifications — Discord
# Create at: https://discord.com/developers/applications
# Bot tab: create bot, copy token. OAuth2 tab: copy client ID/secret, add redirect URI.
# Bot needs "Send Messages" permission and must share a server with the user to DM them.
DISCORD_CLIENT_ID="your-discord-client-id"
DISCORD_CLIENT_SECRET="your-discord-client-secret"
DISCORD_BOT_TOKEN="your-discord-bot-token"
# Must match a redirect URI registered in the Discord developer portal EXACTLY.
# Nothing derives this from the request origin, so dev and prod each need their own value.
DISCORD_REDIRECT_URI="http://localhost:5173/account/notifications/settings/discord/callback"

# Notifications — Encryption (required for Discord token storage)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="64-char-hex-string"

# Notifications — Delivery interval in milliseconds (default: 15000 = 15s)
DELIVERY_INTERVAL_MS=""

# Notifications — Web Push (VAPID)
# Generate the keypair: bunx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="BExample-base64url-public-key"
# Server secret — never expose to the client (unlike the public key above)
VAPID_PRIVATE_KEY="Example-base64url-private-key"
# Contact URI a push service can use if this deployment misbehaves
VAPID_SUBJECT="mailto:you@yourdomain.com"

# ── Security secrets ─────────────────────────────────────────────────────────
# Bearer credential for the private admin MCP endpoint (/api/mcp/admin).
# Machine secret — never commit. Unset ⇒ the endpoint returns 503, never public.
# Generate with: openssl rand -base64 32
MCP_ADMIN_TOKEN=""
# Bearer credential for the private PATTERN endpoint (/api/mcp/private) — a
# separate realm from MCP_ADMIN_TOKEN; neither token opens the other surface.
# Held only by the operator's own projects: it is the switch that turns full
# self-telemetry (query + answer capture) on. Unset ⇒ the endpoint returns 503.
# Generate with: openssl rand -hex 32
MCP_PRIVATE_TOKEN=""
# HMAC key for MCP usage-telemetry caller keys: client_key = HMAC-SHA256(salt,
# ip:ua:UTC-date). Unset ⇒ client_key is NULL (fails open on the column, never
# the row) — the admin Capability Gaps panel needs >=3 distinct callers before
# it shows a query, so with no salt it stays permanently empty, and the private
# lane's repeat-ask probe has nothing to join on. Should rotate.
# Generate with: openssl rand -base64 32
MCP_TELEMETRY_SALT=""
# Shared secret the operator's own tooling sends as the X-V10r-Self header so
# its MCP calls are classified traffic='self' instead of 'external'. Unset ⇒
# your own curl counts as external adoption in the usage dashboard.
MCP_SELF_TRAFFIC_TOKEN=""
# Extra browser origins allowed to call the MCP endpoints, comma-separated.
# DNS-rebinding protection: same-origin is always allowed and a request with no
# Origin (a non-browser MCP client) is always allowed, so this is only needed for
# a browser-based client on another origin — e.g. the MCP Inspector.
# Entries are compared as FULL origins. A bare host is normalized to https://,
# so write the scheme out when you actually mean plaintext.
# Example: MCP_ALLOWED_ORIGINS="http://127.0.0.1:6274,https://inspector.example"
MCP_ALLOWED_ORIGINS=""
# HMAC key signing the v10r_debug_owner pairing cookie, which attributes a
# phone's analytics events to an admin WITHOUT that phone being logged in.
# Unset ⇒ pairing fails closed. Generate with: openssl rand -base64 32
PAIRING_SECRET=""
# Optional per-purpose overrides for keys otherwise derived from
# BETTER_AUTH_SECRET via HMAC domain separation (see security/subkey.ts).
# Leave unset unless you are rotating one key independently of the auth secret.
# ANALYTICS_VISITOR_SALT rotation re-buckets visitor_id: rotate at or above the
# 60-day analytics retention window and at most one boundary can fall inside any
# reporting range. Generate with: openssl rand -base64 32
ANALYTICS_VISITOR_SALT=""
BLOG_UPLOAD_TICKET_SECRET=""

# Cron / Scheduled Jobs
# Secret for authenticating Vercel cron HTTP requests (must match vercel.json bearer token)
CRON_SECRET="generate-with-openssl-rand-base64-32"
# Container-mode job interval in milliseconds (default: 10800000 = 3 hours)
JOB_INTERVAL_MS=""

# ── DB Monitoring (Admin) ────────────────────────────────────────────────────
UPSTASH_MGMT_API_KEY=""
UPSTASH_EMAIL=""
UPSTASH_DB_ID=""
CLOUDFLARE_ANALYTICS_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""

# ── Anti-Abuse ───────────────────────────────────────────────────────────────
# ALTCHA HMAC key (signs/verifies captcha challenges). 32+ chars required in prod.
# Generate with: openssl rand -hex 32
ALTCHA_HMAC_KEY=""
# Mode: live (enforce) | dry_run (audit only) | off (skip). Default: live.
BOT_DETECTION_MODE="live"
