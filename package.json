{
	"name": "velociraptor",
	"private": true,
	"license": "MIT",
	"version": "0.0.1",
	"description": "Full-stack SvelteKit template focused on performance and lightweight deployment",
	"author": "ApeDevil (https://github.com/ApeDevil)",
	"repository": {
		"type": "git",
		"url": "https://github.com/ApeDevil/v10r"
	},
	"keywords": [
		"sveltekit",
		"svelte5",
		"bun",
		"template",
		"drizzle",
		"unocss",
		"better-auth",
		"neon",
		"neo4j"
	],
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"postinstall": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"prepare": "svelte-kit sync || echo ''",
		"check": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && svelte-kit sync && bun run scripts/quality/svelte-check-gate.ts",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold error --watch",
		"db:push": "bunx drizzle-kit push",
		"db:studio": "bunx drizzle-kit studio",
		"db:retrieval-pre": "bun run scripts/db/setup-retrieval.ts pre",
		"db:retrieval-post": "bun run scripts/db/setup-retrieval.ts post",
		"db:neo4j-setup": "bun run scripts/db/setup-neo4j.ts",
		"db:seed": "bun run scripts/db/seed.ts",
		"db:search-backfill": "bun run scripts/db/setup-search.ts",
		"db:catalog-sync": "bun run scripts/db/catalog-sync.ts",
		"db:setup": "bun run db:retrieval-pre && bun run db:push && bun run db:retrieval-post && bun run db:neo4j-setup && bun run db:catalog-sync && bun run db:seed && bun run db:search-backfill",
		"db:seed:silly": "bun run scripts/db/seed-silly.ts",
		"db:ingest-docs": "bun run scripts/db/ingest-docs.ts",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"test": "vitest run",
		"test:mcp": "cd mcp && bun test",
		"test:browser": "playwright test",
		"test:watch": "vitest",
		"i18n:check-missing": "bun run scripts/i18n/check-missing.ts",
		"content:new": "bun run scripts/content/new.ts",
		"content:push": "bun run scripts/content/push.ts",
		"content:check": "bun run scripts/content/check.ts --offline",
		"content:check:db": "bun run scripts/content/check.ts",
		"validate:build": "NODE_ENV=production bun run build && NODE_ENV=production bun run scripts/perf/snapshot.ts --check",
		"perf:snapshot": "NODE_ENV=production bun run build && NODE_ENV=production bun run scripts/perf/snapshot.ts",
		"quality:opacity": "bun run scripts/quality/no-token-opacity.ts",
		"perf:cold-start": "bash scripts/perf/cold-start.sh",
		"perf:scenarios": "bun run scripts/perf/scenarios.ts",
		"perf:locality": "bun run scripts/perf/locality.ts",
		"ai:record-turn": "bun run scripts/ai/record-turn-fixture.ts",
		"ai:eval": "bun run scripts/ai/eval.ts",
		"pim": "bun run scripts/pim/sheet.ts",
		"pim:build": "bun run scripts/pim/build.ts",
		"pwa:icons": "bun run scripts/pwa/generate-icons.ts",
		"patterns:validate": "bun run pattern-library/validate.ts",
		"mcp:excerpts:build": "bun run scripts/mcp/build-public-excerpts.ts",
		"mcp:excerpts:check": "bun run scripts/mcp/build-public-excerpts.ts --check",
		"mcp:bench": "bun run scripts/mcp/retrieval-bench.ts",
		"patterns:build": "bun run scripts/patterns/build-derived.ts",
		"patterns:check": "bun run scripts/patterns/build-derived.ts --check",
		"audit": "bun audit --audit-level=high",
		"validate": "bun run check && biome ci . && bun run test && bun run test:mcp && bun run patterns:validate && bun run patterns:check && bun run mcp:excerpts:check && bun run i18n:check-missing && bun run content:check && bun run quality:opacity",
		"refresh": "bun run patterns:validate && bun run patterns:build && bun run mcp:excerpts:build && bun run db:ingest-docs",
		"knip": "knip",
		"external-service:contract": "bun run scripts/external-service/generate-contract.ts",
		"external-service:verify": "bun run scripts/external-service/verify.ts"
	},
	"dependencies": {
		"@ai-sdk/google": "^3.0.62",
		"@ai-sdk/groq": "^3.0.35",
		"@ai-sdk/openai": "^3.0.52",
		"@ai-sdk/svelte": "^3.0.0",
		"@aws-sdk/client-s3": "^3.700.0",
		"@aws-sdk/s3-request-presigner": "^3.700.0",
		"@better-auth/passkey": "1.6.22",
		"@fontsource-variable/fraunces": "^5.0.0",
		"@fontsource-variable/inter": "^5.0.0",
		"@fontsource-variable/jetbrains-mono": "^5.0.0",
		"@fontsource-variable/nunito": "^5.0.0",
		"@fontsource-variable/playfair-display": "^5.0.0",
		"@fontsource-variable/space-grotesk": "^5.0.0",
		"@internationalized/date": "^3.7.0",
		"@neondatabase/serverless": "^1.0.0",
		"@shikijs/rehype": "^3.0.0",
		"@threlte/core": "^8.3.1",
		"@threlte/extras": "^9.0.0",
		"@upstash/ratelimit": "^2.0.0",
		"@upstash/redis": "^1.36.0",
		"@valibot/to-json-schema": "^1.5.0",
		"@vercel/analytics": "^2.0.1",
		"@vercel/functions": "^3.7.5",
		"@xyflow/svelte": "^1.0.0",
		"ai": "^6.0.0",
		"altcha": "^3.0.8",
		"altcha-lib": "^2.0.0",
		"better-auth": "1.6.22",
		"bits-ui": "^2.17.3",
		"chart.js": "^4.4.0",
		"class-variance-authority": "^0.7.0",
		"clsx": "^2.1.0",
		"culori": "^4.0.0",
		"d3-dag": "^1.1.0",
		"d3-force": "^3.0.0",
		"d3-hierarchy": "^3.1.0",
		"d3-sankey": "^0.12.3",
		"d3-selection": "^3.0.0",
		"d3-zoom": "^3.0.0",
		"drizzle-orm": "^0.45.2",
		"exifreader": "^4.31.1",
		"gray-matter": "^4.0.3",
		"hast-util-to-string": "^3.0.0",
		"maplibre-gl": "^5.0.0",
		"marked": "^15.0.0",
		"paneforge": "^1.0.2",
		"qrcode": "^1.5.4",
		"read-excel-file": "^9.3.12",
		"rehype-sanitize": "^6.0.0",
		"rehype-slug": "^6.0.0",
		"rehype-stringify": "^10.0.0",
		"remark-directive": "^4.0.0",
		"remark-frontmatter": "^5.0.0",
		"remark-gfm": "^4.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.0.0",
		"sanitize-html": "2.17.5",
		"sharp": "^0.35.3",
		"shiki": "^3.0.0",
		"svelte-maplibre-gl": "^1.0.3",
		"sveltekit-superforms": "^3.0.0",
		"three": "^0.183.2",
		"unified": "^11.0.0",
		"unist-util-visit": "^5.0.0",
		"uuid": "^14.0.0",
		"valibot": "^1.2.0",
		"web-push": "^3.6.7",
		"web-vitals": "^5.1.0",
		"write-excel-file": "^4.1.1",
		"yaml": "^2.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.0.0",
		"@electric-sql/pglite": "^0.3.14",
		"@iconify-json/lucide": "^1.2.0",
		"@inlang/paraglide-js": "^2.18.0",
		"@inlang/plugin-m-function-matcher": "^2.3.4",
		"@inlang/plugin-message-format": "^4.5.5",
		"@modelcontextprotocol/sdk": "^1.12.0",
		"@playwright/test": "1.56.1",
		"@sveltejs/adapter-vercel": "^7.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/culori": "^4.0.0",
		"@types/d3-force": "^3.0.0",
		"@types/d3-hierarchy": "^3.1.0",
		"@types/d3-sankey": "^0.12.0",
		"@types/d3-selection": "^3.0.0",
		"@types/d3-zoom": "^3.0.0",
		"@types/qrcode": "^1.5.5",
		"@types/sanitize-html": "^2.13.0",
		"@types/three": "^0.183.1",
		"@types/web-push": "^3.6.4",
		"@unocss/transformer-directives": "^66.11.0",
		"drizzle-kit": "^0.31.0",
		"knip": "^6.3.1",
		"openapi-typescript": "^7.13.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "~6.0.3",
		"unocss": "^66.11.0",
		"vite": "^8.3.5",
		"vitest": "^4.1.12"
	},
	"overrides": {
		"@simplewebauthn/browser": "13.2.x",
		"@simplewebauthn/server": "13.2.x",
		"devalue": "^5.8.1"
	},
	"packageManager": "bun@1.3.12",
	"engines": {
		"node": ">=22.17.0",
		"bun": ">=1.3.12"
	},
	"imports": {
		"#lib/*": "./src/lib/*",
		"#patterns/*": "./pattern-library/*"
	}
}
