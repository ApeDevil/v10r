#!/usr/bin/env bash
#
# vr — velociraptor solo-dev CLI. A thin dispatcher; real logic lives in scripts/.
# Add a command by adding a case below (and a row to the menu).
#
set -euo pipefail

# Resolve our real location (survives the ~/.local/bin symlink) to find the
# toolkit's scripts. The repo we ACT on is your cwd — resolved by require_repo
# (from lib.sh), so `vr` works in whatever repo you're standing in.
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
# shellcheck source=../scripts/lib.sh
source "$(dirname "$SELF")/../scripts/lib.sh"
SCRIPTS="$TOOLKIT_DIR"

menu() {
	cat <<'EOF'
vr — solo-dev cli (acts on the git repo you're standing in)

  ship, s           gate + promote current branch → main (deploys on push)
  validate, v       run the full gate (bun run validate) in the container
  dev               start the dev server (podman compose up, foreground)
  up                start the container in the background
  down              stop the container
  shell, sh         open a shell inside the running container
  install           symlink `vr` into ~/.local/bin (run once)
  help              show this menu

Runs against the current repo's compose.yaml + git remote. The container and
service are read from compose.yaml (zero config). Branch/remote overrides go in a
committed .vrrc or V10R_* env. Run `vr ship -h` for flags (--dry-run, --keep, --yes).
EOF
}

cmd="${1:-help}"
[ $# -gt 0 ] && shift || true

case "$cmd" in
	ship|s)        exec bash "$SCRIPTS/ship.sh" "$@" ;;
	validate|v)    exec bash "$SCRIPTS/validate.sh" "$@" ;;
	dev)           require_repo; exec "${COMPOSE[@]}" up "$@" ;;
	up)            require_repo; exec "${COMPOSE[@]}" up -d "$@" ;;
	down)          require_repo; exec "${COMPOSE[@]}" down "$@" ;;
	shell|sh)      require_repo; exec "${COMPOSE[@]}" exec "$(compose_service)" bash ;;
	install)
		target="${HOME}/.local/bin/vr"
		mkdir -p "${HOME}/.local/bin"
		ln -sf "$SELF" "$target"
		echo "Linked: $target → $SELF"
		echo "Now 'vr <cmd>' works from anywhere (~/.local/bin is on your PATH)."
		;;
	help|-h|--help) menu ;;
	*)
		printf 'vr: unknown command %q\n\n' "$cmd" >&2
		menu >&2
		exit 1
		;;
esac
