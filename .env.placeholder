# .env.placeholder — fake values for hermetic runs with no container and no secrets:
# Claude Code cloud sessions (scripts/cloud/session-start.sh) copy it to .env.
#
# Only what a build needs is listed: two `$env/static/private` imports (typecheck fails when
# they are unset) and the modules that assert their config at load during prerender (auth,
# abuse). Tests need none — vitest.setup.ts supplies its own fallbacks and strips service
# env on purpose. Every value is fake and points nowhere; none may start with a word the
# load-time checks reject as a dummy (`test-`, `placeholder`, `changeme`, …). Never put a
# real credential here.

# $env/static/private imports (showcases/db/*/connection/+page.server.ts)
R2_ACCOUNT_ID="fake-account"
UPSTASH_REDIS_REST_URL="https://fake.invalid"

# src/lib/server/auth/index.ts — required at module load (secret: 32+ chars)
BETTER_AUTH_SECRET="fake-better-auth-secret-not-for-any-deployment"
BETTER_AUTH_URL="http://localhost:5173"
GITHUB_CLIENT_ID="fake"
GITHUB_CLIENT_SECRET="fake"
GOOGLE_CLIENT_ID="fake"
GOOGLE_CLIENT_SECRET="fake"

# src/lib/server/security/encryption-key.ts — 64 hex chars at module load (public, fake:
# nothing sealed with it ever exists)
ENCRYPTION_KEY="fafafafafafafafafafafafafafafafafafafafafafafafafafafafafafafafa"

# src/lib/server/abuse/config.ts — production assertion at module load (32+ chars)
ALTCHA_HMAC_KEY="fake-altcha-hmac-key-not-for-any-deployment"
BOT_DETECTION_MODE="live"
